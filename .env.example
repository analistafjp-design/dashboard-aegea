# Copie para .env e ajuste conforme o ambiente.
# Todas as variáveis são opcionais — o sistema roda sem nenhuma delas.

# Nome exibido no cabeçalho
APP_NOME=Dashboard Executivo

# Logs detalhados (true apenas em desenvolvimento)
DEBUG=false

# Banco de dados.
# SQLite (padrão):     sqlite:///./data/database/dashboard.db
# PostgreSQL:          postgresql+psycopg://usuario:senha@servidor:5432/dashboard
DATABASE_URL=sqlite:///./data/database/dashboard.db

# Pasta de dados (uploads, arquivos processados, banco e logs)
DATA_DIR=./data

# Limite de upload em megabytes
TAMANHO_MAXIMO_MB=50

# Tempo de vida do cache de indicadores, em segundos.
# O cache também é invalidado automaticamente a cada importação.
CACHE_TTL=300
